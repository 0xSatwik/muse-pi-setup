  "tests": [
    {
      "description": "coding/python-dedupe",
      "vars": {
        "prompt": "Write Python function dedupe(xs) that preserves first occurrence order for a list of hashable items. Return only Python code.",
        "task": "python-dedupe",
        "expected": "[\"def dedupe\", \"return\"]"
      },
      "assert": [
        {
          "type": "javascript",
          "value": "file://assertions.cjs"
        }
      ]
    },
    {
      "description": "coding/sql-left-join",
      "vars": {
        "prompt": "Tables users(id) and orders(id,user_id). Write SQL returning every user id and their order count including users with zero orders. Output only SQL.",
        "task": "sql-left-join",
        "expected": "[\"LEFT JOIN\", \"COUNT\", \"GROUP BY\"]"
      },
      "assert": [
        {
          "type": "javascript",
          "value": "file://assertions.cjs"
        }
      ]
    },
    {
      "description": "coding/python-bug",
      "vars": {
        "prompt": "What does Python print?\ndef f(x, acc=[]):\n    acc.append(x)\n    return acc\nf(1)\nprint(f(2))\nReply only with the printed list.",
        "task": "python-bug",
        "expected": "[\"[1, 2]\"]"
      },
      "assert": [
        {
          "type": "javascript",
          "value": "file://assertions.cjs"
        }
      ]
    },
    {
      "description": "reasoning/probability",
      "vars": {
        "prompt": "A fair coin is tossed 3 times. What is the probability of exactly two heads? Reply only as a reduced fraction.",
